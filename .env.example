# Which basemap tile source DeckLineLayerMap.jsx uses — see BASEMAP_SOURCES
# in src/js/Components/deckgl/DeckLineLayerMap.jsx for the valid keys and what each
# one means (offline/commercial-safe vs. online/non-commercial).
#
# natural_earth      - offline, self-rendered, public-domain, commercial-safe
# carto_dark_online  - live tiles from CARTO's free tier, non-commercial only
ACTIVE_BASEMAP=natural_earth

# Base URL of the Django backend. Used by BackendStatus.jsx for the health
# check and by DeckLineLayerMapAdv's endpoints.js to derive the WebSocket URL.
API_BASE_URL=http://localhost:8002

# Row budget for a single Historic window in DeckLineLayerMapAdv. Reaching it
# ends the window early; the rest of the date is reached with the Legend's
# next-window control. usePrefetch.js falls back to 700000 when unset.
MAX_WINDOW_SEGMENTS=700000
