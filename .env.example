# Which basemap tile source DeckLineLayerMap.jsx uses — see BASEMAP_SOURCES
# in src/js/Components/DeckLineLayerMap.jsx for the valid keys and what each
# one means (offline/commercial-safe vs. online/non-commercial).
#
# natural_earth      - offline, self-rendered, public-domain, commercial-safe
# carto_dark_online  - live tiles from CARTO's free tier, non-commercial only
ACTIVE_BASEMAP=natural_earth

# Where the backend lives. BackendStatus.jsx polls it, and the deckgl pages
# build their data URLs off it. Port must match whatever the backend is
# actually bound to — see PROJECT_PORTS.md.
API_BASE_URL=http://localhost:8002

# Upper bound on segments held in the playback buffer at once. Historic only —
# the ticking modes stay bounded by their own trailing-window eviction.
MAX_WINDOW_SEGMENTS=700000
